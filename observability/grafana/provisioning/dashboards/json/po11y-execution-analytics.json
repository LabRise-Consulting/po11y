          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "max by (workflow_name) (po11y_workflow_running_seconds > 0)",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "{{workflow_name}}",
          "refId": "A"
        }
      ],
      "title": "Oldest running execution",
