# ---- network ---------------------------------------------------------------
# Interface every service binds to. 127.0.0.1 = this machine only (safe
# default). Set a private VPN/LAN IP to reach the dashboard from other
# devices. Never 0.0.0.0.
BIND_ADDR=127.0.0.1
DASHBOARD_PORT=8080
TZ=Europe/Berlin
# Optional "user:password" HTTP Basic Auth over the whole dashboard (static
# app, feeds, grafana/prometheus proxies). Empty = no auth — fine on
# 127.0.0.1; set it when BIND_ADDR is a shared-network IP. Plain HTTP still —
# put a TLS proxy in front before untrusted networks.
DASHBOARD_BASIC_AUTH=
# No container runtime socket is mounted anywhere in the stack, so there is no
# host GID wiring to do and a compromised n8n cannot reach the host daemon.

# ---- n8n owner account (bootstrap creates it headlessly) --------------------
# Password policy: >=8 chars, >=1 number, >=1 capital. Left empty, bootstrap
# generates a compliant one and writes it back here.
N8N_OWNER_EMAIL=admin@example.com
N8N_OWNER_PASSWORD=

# ---- n8n DataTable read proxy (optional) -------------------------------------
# Powers the /n8n-table/ read proxy so a "list" tab can read a Data Table live
# without the browser ever holding a key. The key is configured on the po11y
# SERVER, not on nginx: nginx only routes /n8n-table/ there, and the server's
# own allowlist (data-tables paths, GET only, 403 for everything else) is what
# keeps the key read-only-to-data-tables on n8n CE, where API keys cannot be
# scoped. Create it in n8n under Settings -> n8n API, scoped to
# "data-table row: read". Leave empty if you don't use a list tab: the MCP
# content tools (po11y_rows, po11y_row) then answer unavailable, and the
# /n8n-table/ proxy still forwards but sends no key, so n8n's own 401 is what
# comes back. Nothing else changes.
N8N_READ_API_KEY=

# ---- postgres (n8n datastore + grafana datasource) --------------------------
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=           # bootstrap generates if empty
# Read-only role used by Grafana's n8n-postgres datasource (and so by the MCP
# po11y_sql tool). Created/granted by bootstrap: SELECT on everything except
# credentials_entity and execution_data.
PO11Y_RO_PASSWORD=                # bootstrap generates if empty

# ---- grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=           # bootstrap (or scripts/readonly-preflight.sh) generates if empty
# Grafana panel embeds on the dashboard (anonymous Viewer + iframes). On by
# default — fine on the 127.0.0.1 bind; consider false when BIND_ADDR is a
# shared-network IP and read-only dashboard access there is unwanted.
DASHBOARD_GRAFANA_EMBED=true

# ---- MCP server ----
# The /mcp route (read-only; behind the dashboard's auth) is served by the
# po11y server process (server/mcp/) — nginx routes /mcp/ straight to it.
# Its request-body cap is PO11Y_MAX_BODY_BYTES, shared with the server's other
# routes; there is no MCP-specific body-size or bind-address variable.
# Every source is optional — an unset one simply disables its tools — EXCEPT
# po11y_sql, which is ON by default on the bundled stack: the server points
# GRAFANA_URL at Grafana internally (see MCP_GRAFANA_URL below). Its guard checks
# statement shape only, never which tables are touched, so it is full read
# access to n8n's database — execution_data (raw workflow payloads) and
# credentials_entity included. Accepted deliberately, because MCP access is
# already dashboard access; read docs/security.md before opening the dashboard
# to anyone who should not have that.
# Leave this empty and bootstrap mints one for you against the bundled n8n, with
# read-only workflow, execution and data-table scopes. It is not only the MCP
# ops key: the server reads n8n over the same public API, so without a key the
# server runs serving-only and the whole dashboard stays empty. Set your own
# here — including a key for a different n8n — and bootstrap never touches it.
MCP_N8N_API_KEY=              # ops reads: executions + workflows (GET-only)
# Where a READER opens n8n, as against where the server sends its polls. The
# server polls http://n8n:5678 over the compose network — an address that
# resolves in that network and nowhere else — so every link po11y hands out
# (MCP tool results, watchdog notifications, webhook pushes) has to name an
# address the operator or agent receiving it can actually open. Defaults to
# http://$BIND_ADDR:5678, the same address n8n builds its own WEBHOOK_URL from.
# Set it when n8n sits behind a reverse proxy or a tunnel.
N8N_PUBLIC_URL=
# The off switch for po11y_sql: set it EMPTY (MCP_GRAFANA_URL=) and the grafana
# source is unavailable, so the tool reports itself off instead of querying.
# Leave the line out entirely and it defaults to the internal Grafana.
MCP_GRAFANA_URL=http://grafana:3000
# Only needed when anonymous Grafana Viewer access is off
# (DASHBOARD_GRAFANA_EMBED=false); po11y_sql is available with or without it,
# and without it a query fails 401 rather than being disabled.
MCP_GRAFANA_SA_TOKEN=
# N8N_READ_API_KEY (above) also powers the content tools.

# ---- grafana alerting (bundled stack, on by default) -------------------------
# Grafana alerts on the bundled stack, reading n8n's own postgres. Five rules
# ship active out of the box — failing, stale, stuck, queue backlog and n8n
# unreachable — and are visible under Alerting in Grafana with no configuration
# at all. See docs/alerting.md and observability/grafana/alerting/rules.yml.
#
# This variable controls DELIVERY only. Leave it empty and the rules still fire;
# they just stay in the Grafana UI. Set it and every firing alert is POSTed
# there, grouped, with a resolved message when it clears.
#
# TREAT THIS URL AS A SECRET — for Slack and Telegram the credential IS the URL.
# It is read from the environment at provisioning time and never written into a
# tracked file.
#
# DELIBERATELY NOT the same variable as po11y's own ALERT_WEBHOOK_URL below.
# Grafana's webhook contact point POSTs GRAFANA'S OWN alert JSON, not the Slack
# or Discord message shapes server/notify.mjs builds — so a Slack incoming
# webhook URL that works fine there would be rejected here. Two names, no
# silent breakage, and no duplicate key in this file.
#
# The natural target is an n8n webhook node: n8n is right there on the bundled
# stack and can fan out to anything. For native Slack/Discord/Telegram
# formatting, add that contact point in Grafana's UI instead — Grafana renders
# those properly.
GRAFANA_ALERT_WEBHOOK_URL=

# ---- AI architecture map (optional) -----------------------------------------
# The Architecture tab ALWAYS renders — its structure is computed from code,
# not a model. An LLM only polishes the prose, and only when the workflow
# structure actually changed (the server skips the LLM call when the map is
# unchanged and fresh), so ongoing cost on a stable stack is near zero.
# Leave these empty for the free heuristic map. To enable the LLM prose, point
# it at any OpenAI-compatible chat-completions endpoint. A cheap model is
# plenty — the prompt is small and infrequent.
# DEFAULT: with the bundled OmniRoute gateway enabled (below) and
# AI_MAP_BASE_URL left empty, bootstrap wires the map to the gateway
# automatically, defaulting AI_MAP_MODEL to `auto/best-free` — OmniRoute's
# free-tier auto-route, which answers with zero provider keys configured. So
# a clean bootstrap gets LLM prose out of the box at no cost. Set
# AI_MAP_MODEL to pin a specific OmniRoute model id (e.g.
# anthropic/claude-haiku-4-5, needs that provider connected in the
# dashboard); set OMNIROUTE_ENABLED=false for the heuristic-only map.
# Bootstrap writes the auto-wired values back into the three keys below, so
# the server picks them up from its environment.
# No API key at all? Point AI_MAP_BASE_URL at a local Ollama, or leave these
# empty for the heuristic map.
#   Mistral (cheap): https://api.mistral.ai/v1     model: mistral-small-latest
#   Anthropic:       https://api.anthropic.com/v1  model: claude-haiku-4-5
#   OpenAI:          https://api.openai.com/v1
#   Ollama (free):   http://host.docker.internal:11434/v1 (set any AI_MAP_API_KEY)
AI_MAP_BASE_URL=
AI_MAP_API_KEY=
AI_MAP_MODEL=
# Token budget for that one annotation call (default 16000). A reasoning model
# spends the SAME budget on its hidden thinking as on the answer, so a budget
# that only just fits the JSON produces a reply that stops mid-string; the
# server logs "LLM answer truncated at max_tokens" and keeps the heuristic
# text. The answer grows with the instance (one line per node, one summary per
# workflow), and a ceiling costs nothing until the model writes to it, so the
# default clears a large map. Raise this if yours still truncates.
AI_MAP_MAX_TOKENS=16000

# ---- bundled OmniRoute gateway (optional overlay, ON by default) -------------
# docker-compose.omniroute.yml runs an OmniRoute LLM gateway
# (https://github.com/diegosouzapw/OmniRoute): one OpenAI-compatible endpoint
# with provider routing/fallback. bootstrap includes the overlay unless
# OMNIROUTE_ENABLED=false. Already running your own OmniRoute (or calling a
# provider directly)? Set false and configure AI_MAP_* above as usual.
# Works out of the box: the default AI_MAP_MODEL auto/best-free routes to
# OmniRoute's keyless free tier. To use better/paid models: open
# http://127.0.0.1:20128, log in with OMNIROUTE_ADMIN_PASSWORD, connect a
# provider, then set AI_MAP_MODEL above.
OMNIROUTE_ENABLED=true
# Image override (pin/upgrade; default in docker-compose.omniroute.yml).
OMNIROUTE_IMAGE=
# Host address the dashboard/proxy publishes on. Loopback by default and NOT
# BIND_ADDR: the /v1 proxy is keyless (REQUIRE_API_KEY=false), so a
# shared-network publish would let anyone there spend your providers' quota.
# To reach the gateway from another machine: make an SSH tunnel or use a VPN
# and keep this on loopback, or set REQUIRE_API_KEY=true and then bind here to
# a private interface. See docs/ai-map.md — requiring a key also means
# AI_MAP_API_KEY must hold a real key, not the bootstrap placeholder.
OMNIROUTE_BIND_ADDR=
# Generated when empty by bootstrap, or by scripts/readonly-preflight.sh on the
# read-only topology, which runs no bootstrap: dashboard session signing,
# at-rest encryption of stored provider keys, first-boot dashboard password.
OMNIROUTE_JWT_SECRET=
OMNIROUTE_API_KEY_SECRET=
OMNIROUTE_ADMIN_PASSWORD=

# ---- retention ----------------------------------------------------------------
# n8n execution history (hours; n8n default 336 = 14 days) — extended so the
# grafana trend charts have history.
EXECUTIONS_DATA_MAX_AGE=4380
PROMETHEUS_RETENTION=180d

# ---- form-trigger submit proxy ----------------------------------------------
# The dashboard's /form/ proxy lets the Actions tab fire n8n field-less form
# triggers same-origin (POST only). ON by default on the bundled stack (the
# Actions tab's whole point). OFF by default on the read-only stack: on a
# shared team box the single DASHBOARD_BASIC_AUTH password would otherwise let
# anyone who can load the dashboard fire triggers, bypassing n8n's own auth
# (the forward-auth overlay plus FORM_ALLOWED_GROUPS makes enabling it
# defensible). Set true/false to override the per-stack default.
ENABLE_FORM_PROXY=
# Upstream the proxy targets. Default http://n8n:5678 (the bundled compose DNS
# name). The read-only stack has no `n8n` service — set this to the remote
# n8n URL if you deliberately enable the proxy there. Whitelisted to
# scheme://host[:port].
FORM_PROXY_UPSTREAM=http://n8n:5678
# Comma-separated OIDC group names allowed to fire forms. Enforced ONLY with the
# forward-auth overlay (below): nginx checks the verified $auth_groups from
# oauth2-proxy. With forward-auth ON and this LEFT EMPTY, form firing is DENIED
# for everyone (deny by default). With forward-auth OFF this has no enforcement
# point (no verified identity) and is ignored — the entrypoint logs a notice.
# Names are whitelisted to [A-Za-z0-9_-]; if your IdP emits group paths (e.g.
# Keycloak "/team-a"), configure it to emit slash-free names (or plain group
# names) so they match. Example: FORM_ALLOWED_GROUPS=platform,on-call
FORM_ALLOWED_GROUPS=

# ---- feed proxy (po11y server) -----------------------------------------------
# The dashboard's status.json/map.json/forms.json/ai-map.json/notifications.json
# feeds always come from the po11y server's own store — nginx proxies every
# feed request there. Upstream the proxy targets. Default http://server:8081
# (the server service's compose DNS name). Whitelisted to scheme://host[:port],
# same rule as FORM_PROXY_UPSTREAM.
FEED_UPSTREAM=http://server:8081

# ---- forward auth (optional overlay) ----------------------------------------
# Real identity via OIDC, instead of the single shared DASHBOARD_BASIC_AUTH
# password. Opt in by adding the overlay to either mode's up command:
#   docker compose -f docker-compose.yml          -f docker-compose.auth.yml up -d
#   docker compose -f docker-compose.readonly.yml -f docker-compose.auth.yml up -d
# The overlay runs an oauth2-proxy in front of the dashboard's nginx (via
# auth_request) and sets FORWARD_AUTH=true. When on, DASHBOARD_BASIC_AUTH is
# ignored (forward-auth wins — no double auth prompt). These vars are read ONLY
# by the overlay; they do nothing without it.
#
# All four below are REQUIRED when the overlay is used (compose fails fast if
# unset). Generic OIDC — works with Keycloak, Authentik, Google, GitLab, Okta:
#   OIDC issuer URL — the .well-known/openid-configuration base, e.g.
#     Keycloak:   https://idp.example.com/realms/<realm>
#     Authentik:  https://idp.example.com/application/o/<app-slug>/
#     Google:     https://accounts.google.com
#     GitLab:     https://gitlab.com
OAUTH2_PROXY_OIDC_ISSUER_URL=
# OAuth2 client id / secret from an app registration on that IdP. The redirect
# URI to register there is  http(s)://<dashboard host>/oauth2/callback.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# Cookie signing/encryption secret. Generate a fresh one:
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
#
# Optional (sensible defaults):
# Restrict which e-mail domains may sign in. '*' = any account the IdP returns;
# set your org's domain(s) (comma-separated) to lock it down.
OAUTH2_PROXY_EMAIL_DOMAINS=*
# Which OIDC claim carries group membership (surfaced as X-Auth-Request-Groups,
# matched by FORM_ALLOWED_GROUPS below). Default 'groups' matches
# Keycloak/Authentik/GitLab; some IdPs use a namespaced claim.
OAUTH2_PROXY_OIDC_GROUPS_CLAIM=groups
# Set true when the dashboard is served over HTTPS (recommended once exposed);
# leave false for a plain-HTTP localhost bind or the session cookie won't return.
OAUTH2_PROXY_COOKIE_SECURE=false
# Override only if your IdP pins an exact redirect URL that differs from the one
# oauth2-proxy derives from the forwarded Host (e.g. behind a TLS proxy):
#   OAUTH2_PROXY_REDIRECT_URL=https://po11y.example.com/oauth2/callback
OAUTH2_PROXY_REDIRECT_URL=
# NOTE: the "upstreams" env var is intentionally plural — oauth2-proxy
# pluralises multi-value args. The overlay hard-codes OAUTH2_PROXY_UPSTREAMS=
# static://202 (auth-endpoint-only; no backend is ever proxied), so you do not
# set it here.

# =============================================================================
# Read-only stack (docker-compose.readonly.yml)
# =============================================================================
# Point po11y at an EXISTING n8n without running n8n/postgres/bootstrap here.
# Bring up with:  docker compose -f docker-compose.readonly.yml up -d
# Reuses from above: BIND_ADDR, DASHBOARD_PORT, DASHBOARD_BASIC_AUTH,
# GRAFANA_ADMIN_PASSWORD, PROMETHEUS_RETENTION, DASHBOARD_GRAFANA_EMBED,
# AI_MAP_* (optional map prose).
#
# Base URL of the remote n8n (required).
N8N_API_URL=
# Optional here, and usually unnecessary: on this stack N8N_API_URL is already
# the URL a reader opens, and an empty value falls back to it. Set it only when
# po11y reaches n8n by an address a reader cannot — a tunnel, a private DNS
# name, a mesh IP — so that the links in tool results and alerts stay openable.
N8N_PUBLIC_URL=
# A public-API key on that n8n (required). Used GET-only by the po11y server.
# On n8n Community Edition keys cannot be scoped, so keep this key to a
# trusted operator: the GET-only discipline the server enforces in code is
# the access control.
N8N_API_KEY=
# Seconds between server polls (default 30). Also read on the bundled stack —
# one name, same default, for whichever compose file starts the server.
# The interval is also the resolution of the live-run view: a workflow that
# finishes in less than one interval can run entirely between two polls, so it
# is recorded but never seen running. Lower this if your workflows are short.
SERVER_POLL_INTERVAL=30
# Recent-executions window fetched per poll (default 250, which is n8n's API
# cap). Size it so the window covers a full poll interval on your instance:
# executions above it are invisible to status.json and the `failing` rule.
# Lower it only to spare a slow n8n the larger response.
# See "Sizing the executions window" in docs/configuration.md.
EXECUTIONS_LIMIT=250
# host:port of the remote n8n's /metrics for prometheus to scrape (required for
# the Grafana tab). The remote n8n must run with N8N_METRICS=true; absent
# metrics just leave the Grafana tab empty.
N8N_METRICS_TARGET=

# --- watchdog (optional) -----------------------------------------------------
# On by default. The po11y server evaluates these rules and writes anything
# worth saying into notifications.json, the feed the dashboard renders. No
# extra n8n calls: the watchdog reads the execution window the poll already
# fetched, and nothing is pushed anywhere unless ALERT_WEBHOOK_URL is set
# below. Enable the `notifications` section in config.json to see them.
#
# Delivery is a separate switch: the watchdog always writes notifications.json;
# only the outbound-push block below decides whether anything is also POSTed
# somewhere.
#
# The default gets you `failing` and `unreachable`: the stale and stuck rules
# stay off until you give them a budget below. Setting this to false switches
# alerting off — including when an ALERT_RULES_FILE enables it; env wins over
# the file in both directions.
ALERTS_ENABLED=true
# failing — alert when a workflow's errors clear BOTH floors within the recent
# window. Both are needed: the count alone spams busy instances, the rate alone
# fires on a workflow that ran once and failed once.
ALERT_MIN_ERRORS=3
ALERT_ERROR_RATE=0.5
# stale — minutes without a SUCCESSFUL execution before alerting. 0 = off. This
# is the silent-failure catch: it also fires on an active workflow with no
# executions at all (dead schedule, expired webhook). Set it above your longest
# legitimate gap or you will alert on the monthly report every month.
ALERT_STALE_AFTER_MIN=0
# stuck — minutes an execution may sit in `running` before alerting. 0 = off.
# Catches the webhook/HTTP call that never resolved; it never becomes an error,
# so nothing else notices it.
ALERT_STUCK_AFTER_MIN=0
# Minutes before an alert that is STILL true is repeated. 0 = say it once only.
ALERT_RENOTIFY_MIN=360
# Comma-separated workflow names (or ids) to exclude from all rules.
ALERT_IGNORE=
# Optional JSON file for per-workflow budgets, e.g.
#   { "perWorkflow": { "Monthly report": { "staleAfterMin": 44640 } } }
# Env vars above always win over the file.
ALERT_RULES_FILE=
# Max entries kept in notifications.json (default 50).
ALERT_FEED_MAX=50

# --- outbound push (optional, on top of the watchdog) ------------------------
# Empty = alerts only land in notifications.json. Set a URL and the same alerts
# are also POSTed to it, batched into one message per feed rebuild.
#
# SENT BY THE po11y SERVER. Both compose files map these variables onto the
# server alone. Never configure a second pusher — two of them deliver every
# alert twice.
#
# TREAT THIS URL AS A SECRET: for Slack and Telegram the credential IS the URL.
# The server never logs it (only scheme + host) and never writes it to a feed.
#   slack     https://hooks.slack.com/services/...   (incoming webhook)
#   discord   https://discord.com/api/webhooks/...   (channel webhook)
#   telegram  https://api.telegram.org/bot<TOKEN>/sendMessage  + chat id below
#   raw       any URL; receives {text, alerts:[…]} — e.g. an n8n webhook, so you
#             can route to email or anything else n8n can reach
ALERT_WEBHOOK_URL=
# One of: slack | discord | telegram | raw. A value outside that list disables
# push with a loud log line rather than posting the wrong shape.
ALERT_WEBHOOK_FORMAT=slack
# Required only when ALERT_WEBHOOK_FORMAT=telegram.
ALERT_TELEGRAM_CHAT_ID=
# Give up on a hung webhook after this many ms (default 10000). A slow endpoint
# delays the poll by at most this much; it never fails it.
ALERT_WEBHOOK_TIMEOUT_MS=10000

# --- dead-man switch (optional, independent of everything above) -------------
# The rules above tell you a WORKFLOW is misbehaving. Losing n8n itself is
# caught separately: a poll that cannot reach n8n raises its own alert (rule
# `unreachable`), deduped and renotified like any other, so a two-day outage is
# one message plus a "recovered", not one per poll.
#
# Neither of those survives THIS box dying — a dead process cannot send a
# message. That needs something off-box. Set a URL here and the po11y SERVER
# GETs it after every SUCCESSFUL workflow sync — the server's own reachability
# probe. When the pings stop, that service alerts you. Works with
# Healthchecks.io, Uptime Kuma push monitors, Better Stack, cron monitors —
# anything that treats a GET as "still alive".
#
# It follows that a bundled-stack server with no MCP_N8N_API_KEY set never
# syncs and so can never ping. That fails safe (the monitor goes red), and the
# server says so at boot rather than leaving you to find out.
#
# TREAT THIS URL AS A SECRET too: the monitor id is in the path, and anyone
# holding it can forge a healthy ping and mute the switch. Same handling as
# ALERT_WEBHOOK_URL — logged as scheme + host only, never written to a feed.
#
# NOT gated on ALERTS_ENABLED: this answers "is po11y alive", not "is a
# workflow misbehaving", and either is useful without the other.
ALERT_HEARTBEAT_URL=
# Give up on a hung heartbeat after this many ms (default 10000). A failed ping
# is logged and ignored — the sync already succeeded.
ALERT_HEARTBEAT_TIMEOUT_MS=10000

# --- Prometheus alerting (optional overlay) ----------------------------------
# docker compose -f docker-compose.readonly.yml -f docker-compose.alerts.yml up -d
#
# An ALTERNATIVE to the server's own ALERT_WEBHOOK_URL push, not an addition
# to it — running both delivers every alert twice. The overlay is the better
# choice if you already run Prometheus seriously: you get silences, grouping and
# inhibition (one dead n8n reports as one alert instead of one per workflow),
# none of which po11y's own push implements or intends to.
#
# The po11y server exports metrics at server:8081/metrics regardless of this
# overlay and regardless of ALERTS_ENABLED — the scrape job is in the base
# config, so the Grafana panels work either way.
#
# Where Alertmanager POSTs. Any webhook receiver; an n8n webhook node is the
# natural sink here. This is a credential — see docs/security.md.
ALERTMANAGER_WEBHOOK_URL=

# There is no SMTP client here on purpose — it would mean a mail dependency,
# credentials on disk and bounce handling. For email, point `raw` at an n8n
# webhook and let n8n send it.
