          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "Failed executions",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "n8n-prometheus"
      },
      "description": "How many distinct workflows have contributed at least one failure within po11y's retention window. Not scoped to the time range.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
