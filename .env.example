# ---- network ---------------------------------------------------------------
# Interface every service binds to. 127.0.0.1 = this machine only (safe
# default). Set a private VPN/LAN IP to reach the dashboard from other
# devices. Never 0.0.0.0.
BIND_ADDR=127.0.0.1
DASHBOARD_PORT=8080
TZ=Europe/Berlin
# Optional "user:password" HTTP Basic Auth over the whole dashboard (static
# app, feeds, grafana/prometheus proxies). Empty = no auth — fine on
# 127.0.0.1; set it when BIND_ADDR is a shared-network IP. Plain HTTP still —
# put a TLS proxy in front before untrusted networks.
DASHBOARD_BASIC_AUTH=
# The host Docker socket is mounted read-only into a docker-socket-proxy
# sidecar (container list only), never into n8n — so no host GID wiring is
# needed and a compromised n8n cannot reach the host Docker daemon.

# ---- n8n owner account (bootstrap creates it headlessly) --------------------
# Password policy: >=8 chars, >=1 number, >=1 capital. Left empty, bootstrap
# generates a compliant one and writes it back here.
N8N_OWNER_EMAIL=admin@example.com
N8N_OWNER_PASSWORD=

# ---- n8n DataTable read proxy (optional) -------------------------------------
# Powers the /n8n-table/ nginx proxy so a "list" tab can read a Data Table
# live without the browser ever holding a key. Create it in n8n under
# Settings -> n8n API, scoped to data-table row: read only. Leave empty if
# you don't use a list tab — nginx still starts fine either way.
N8N_READ_API_KEY=

# ---- postgres (n8n datastore + grafana datasource) --------------------------
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=           # bootstrap generates if empty

# ---- grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=           # bootstrap generates if empty
# Grafana panel embeds on the dashboard (anonymous Viewer + iframes). On by
# default — fine on the 127.0.0.1 bind; consider false when BIND_ADDR is a
# shared-network IP and read-only dashboard access there is unwanted.
DASHBOARD_GRAFANA_EMBED=true

# ---- AI architecture map (optional) -----------------------------------------
# The Architecture tab ALWAYS renders — its structure is computed from code,
# not a model. An LLM only polishes the prose, and only when the workflow
# structure actually changed (the maps workflow skips the LLM call when the
# map is unchanged and fresh), so ongoing cost on a stable stack is near zero.
# Leave these empty for the free heuristic map. To enable the LLM prose, point
# it at any OpenAI-compatible chat-completions endpoint. A cheap model is
# plenty — the prompt is small and infrequent.
# No API key at all? ./ai-map-cli.sh builds the same map through a local AI CLI
# (claude -p by default; override with AI_MAP_CLI), or use a local Ollama.
#   Mistral (cheap): https://api.mistral.ai/v1     model: mistral-small-latest
#   Anthropic:       https://api.anthropic.com/v1  model: claude-haiku-4-5
#   OpenAI:          https://api.openai.com/v1
#   Ollama (free):   http://host.docker.internal:11434/v1 (set any AI_MAP_API_KEY)
AI_MAP_BASE_URL=
AI_MAP_API_KEY=
AI_MAP_MODEL=

# ---- retention ----------------------------------------------------------------
# n8n execution history (hours; n8n default 336 = 14 days) — extended so the
# grafana trend charts have history.
EXECUTIONS_DATA_MAX_AGE=4380
PROMETHEUS_RETENTION=180d
