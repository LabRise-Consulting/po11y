      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "n8n-prometheus"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "count(po11y_workflow_errors_total > 0) or vector(0)",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "Workflows failing",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "n8n-prometheus"
      },
      "description": "Workflows with an execution in flight at the last poll. A workflow that finishes inside one SERVER_POLL_INTERVAL can start and end between two polls, and is then recorded but never seen running.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.3.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "n8n-prometheus"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "count(po11y_workflow_running_seconds > 0) or vector(0)",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "Currently running",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "n8n-prometheus"
      },
      "description": "Whether po11y's last poll reached the n8n public API. Everything else on this dashboard goes stale when this is down.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
