{
  "title": "Po11y",
  "lede": "Read-only view of an existing n8n: feeds are published by the po11y server, which only ever GETs from the n8n public API. scripts/readonly-preflight.sh fills baseUrl and n8nUrl in from .env; set them by hand if you skip it.",
  "baseUrl": "",
  "n8nUrl": "http://{host}:5678",
  "formProxy": false,
  "footer": [
    { "text": "po11y", "href": "https://github.com/labrise-consulting/po11y" }
  ],
  "cards": {
    "Actions": [
      { "name": "New workflow", "sub": "open the n8n editor", "href": "{n8n}/workflow/new" }
    ],
    "Monitoring": [
      { "name": "n8n", "sub": "workflow editor", "href": "{n8n}/",
        "up": "up{job=\"n8n\"}", "mem": "process_resident_memory_bytes{job=\"n8n\"}" },
      { "name": "Execution health", "sub": "failures, runs and freshness — from po11y's own metrics", "href": "/grafana/d/po11y-executions" },
      { "name": "System health", "sub": "n8n process metrics", "href": "/grafana/d/adv6qmb" },
      { "name": "Form executions", "sub": "form-trigger submissions", "href": "/grafana/d/n8n-form-executions" },
      { "name": "Webhook executions", "sub": "webhook calls — needs N8N_METRICS_INCLUDE_WEBHOOK_METRICS upstream", "href": "/grafana/d/n8n-webhook-executions" },
      { "name": "Grafana", "sub": "all dashboards", "href": "/grafana/" },
      { "name": "Prometheus", "sub": "raw metrics", "href": "http://{self}:9090/" }
    ]
  },
  "tabs": [
    { "id": "map", "label": "Map", "src": "/site/map.html" },
    { "id": "arch", "label": "Architecture", "src": "/site/ai-map.html" }
  ],
  "sections": {
    "executions": "Workflow executions",
    "notifications": "Notifications"
  },
  "metrics": {
    "heading": "Metrics",
    "grafana": {
      "embed": true,
      "base": "/grafana",
      "dashboard": "po11y-executions",
      "panels": [
        { "id": 5, "title": "Success rate", "span": 1, "h": 160 },
        { "id": 1, "title": "Failed executions", "span": 1, "h": 160 },
        { "id": 6, "title": "Executions finished", "span": 1, "h": 160 },
        { "id": 4, "title": "n8n reachable", "span": 1, "h": 160 },
        { "id": 10, "title": "Failures over time", "span": 4, "h": 300 },
        { "id": 20, "title": "Workflows with most failures", "span": 2, "h": 340 },
        { "id": 22, "title": "Failure rate by workflow", "span": 2, "h": 340 },
        { "id": 21, "title": "Time since last success", "span": 4, "h": 340 }
      ],
      "range": "now-24h"
    },
    "promBase": "/prom"
  },
  "refreshSec": 30,
  "staleAfterMin": 20,
  "statusHint": "status.json missing — the first server poll runs at startup, then every SERVER_POLL_INTERVAL (default 30 s)"
}
