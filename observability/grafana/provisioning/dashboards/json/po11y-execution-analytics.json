      "pluginVersion": "11.3.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "n8n-prometheus"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "po11y_n8n_up",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "n8n reachable",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "n8n-prometheus"
      },
      "description": "New failed executions per interval, split by workflow. This is a rate over the counter, so it shows only failures that happened while Prometheus was scraping \u2014 the totals above cover the whole retention window.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "drawStyle": "bars",
            "fillOpacity": 30,
            "gradientMode": "none",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "mappings": [],
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "id": 10,
      "options": {
        "legend": {
          "calcs": [
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "11.3.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "n8n-prometheus"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "sum by (workflow_name) (increase(po11y_workflow_errors_total[$__rate_interval]))",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "{{workflow_name}}",
          "refId": "A"
        }
      ],
      "title": "Failures over time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "n8n-prometheus"
      },
      "description": "The ten workflows with the most failed executions in po11y's retention window. Not scoped to the time range \u2014 the graph above is what answers \"when\".",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "mappings": [],
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
