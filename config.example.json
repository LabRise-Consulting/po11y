{
  "title": "Po11y",
  "lede": "Live view of this stack: executions and notifications refresh every 30 s from status.json (published by the po11y server); the Map tab is generated from the n8n instance itself.",
  "footer": [
    { "text": "po11y", "href": "https://github.com/labrise-consulting/po11y" }
  ],
  "cards": {
    "Actions": [
      { "name": "New workflow", "sub": "open the n8n editor", "href": "{n8n}/workflow/new" }
    ],
    "Monitoring": [
      { "name": "n8n", "sub": "workflow editor", "href": "{n8n}/",
        "up": "up{job=\"n8n\"}", "mem": "process_resident_memory_bytes{job=\"n8n\"}" },
      { "name": "Execution analytics", "sub": "grafana", "href": "/grafana/d/adfcxfk" },
      { "name": "Execution health", "sub": "the same ground from po11y's own metrics, independent of n8n's database", "href": "/grafana/d/po11y-executions" },
      { "name": "System health", "sub": "n8n process metrics", "href": "/grafana/d/adv6qmb" },
      { "name": "Form executions", "sub": "form-trigger submissions", "href": "/grafana/d/n8n-form-executions" },
      { "name": "Webhook executions", "sub": "webhook calls", "href": "/grafana/d/n8n-webhook-executions" },
      { "name": "Prometheus", "sub": "raw metrics", "href": "http://{self}:9090/" },
      { "name": "OmniRoute", "sub": "LLM gateway", "href": "http://{self}:20128/",
        "tip": "Bundled OmniRoute gateway — connect providers, inspect routing. Loopback-only by default (OMNIROUTE_BIND_ADDR); remove this card if you set OMNIROUTE_ENABLED=false" }
    ]
  },
  "tabs": [
    { "id": "map", "label": "Map", "src": "/site/map.html" },
    { "id": "arch", "label": "Architecture", "src": "/site/ai-map.html" }
  ],
  "sections": {
    "executions": "Workflow executions",
    "notifications": "Notifications"
  },
  "metrics": {
    "heading": "Metrics",
    "grafana": {
      "embed": true,
      "base": "/grafana",
      "dashboard": "adfcxfk",
      "panels": [
        { "id": 19, "title": "Success rate", "span": 1, "h": 340 },
        { "id": 26, "title": "Executions over time by status", "span": 3, "h": 340 },
        { "id": 16, "title": "Total workflows", "span": 1, "h": 160 },
        { "id": 17, "title": "Active workflows", "span": 1, "h": 160 },
        { "id": 18, "title": "Total executions", "span": 1, "h": 160 },
        { "id": 20, "title": "Failed executions", "span": 1, "h": 160 },
        { "id": 21, "title": "Currently running", "span": 1, "h": 160 },
        { "id": 24, "title": "P95, Max, Avg & Median duration (24h)", "span": 3, "h": 160 },
        { "id": 30, "title": "Most executed workflows", "span": 2, "h": 340 },
        { "id": 28, "title": "Workflows with most failures", "span": 2, "h": 340 }
      ],
      "range": "now-24h"
    },
    "promBase": "/prom"
  },
  "refreshSec": 30,
  "staleAfterMin": 5,
  "statusHint": "status.json missing — first schedule tick lands within ~2 min of bootstrap"
}
