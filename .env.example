# ---- network ---------------------------------------------------------------
# Interface every service binds to. 127.0.0.1 = this machine only (safe
# default). Set a private VPN/LAN IP to reach the dashboard from other
# devices. Never 0.0.0.0.
BIND_ADDR=127.0.0.1
DASHBOARD_PORT=8080
TZ=Europe/Berlin
# Optional "user:password" HTTP Basic Auth over the whole dashboard (static
# app, feeds, grafana/prometheus proxies). Empty = no auth — fine on
# 127.0.0.1; set it when BIND_ADDR is a shared-network IP. Plain HTTP still —
# put a TLS proxy in front before untrusted networks.
DASHBOARD_BASIC_AUTH=
# The host Docker socket is mounted read-only into a docker-socket-proxy
# sidecar (container list only), never into n8n — so no host GID wiring is
# needed and a compromised n8n cannot reach the host Docker daemon.

# ---- n8n owner account (bootstrap creates it headlessly) --------------------
# Password policy: >=8 chars, >=1 number, >=1 capital. Left empty, bootstrap
# generates a compliant one and writes it back here.
N8N_OWNER_EMAIL=admin@example.com
N8N_OWNER_PASSWORD=

# ---- n8n DataTable read proxy (optional) -------------------------------------
# Powers the /n8n-table/ nginx proxy so a "list" tab can read a Data Table
# live without the browser ever holding a key. Create it in n8n under
# Settings -> n8n API, scoped to data-table row: read only. Leave empty if
# you don't use a list tab — nginx still starts fine either way.
N8N_READ_API_KEY=

# ---- postgres (n8n datastore + grafana datasource) --------------------------
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=           # bootstrap generates if empty

# ---- grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=           # bootstrap generates if empty
# Grafana panel embeds on the dashboard (anonymous Viewer + iframes). On by
# default — fine on the 127.0.0.1 bind; consider false when BIND_ADDR is a
# shared-network IP and read-only dashboard access there is unwanted.
DASHBOARD_GRAFANA_EMBED=true

# ---- AI architecture map (optional) -----------------------------------------
# The Architecture tab ALWAYS renders — its structure is computed from code,
# not a model. An LLM only polishes the prose, and only when the workflow
# structure actually changed (the maps workflow skips the LLM call when the
# map is unchanged and fresh), so ongoing cost on a stable stack is near zero.
# Leave these empty for the free heuristic map. To enable the LLM prose, point
# it at any OpenAI-compatible chat-completions endpoint. A cheap model is
# plenty — the prompt is small and infrequent.
# No API key at all? ./ai-map-cli.sh builds the same map through a local AI CLI
# (claude -p by default; override with AI_MAP_CLI), or use a local Ollama.
#   Mistral (cheap): https://api.mistral.ai/v1     model: mistral-small-latest
#   Anthropic:       https://api.anthropic.com/v1  model: claude-haiku-4-5
#   OpenAI:          https://api.openai.com/v1
#   Ollama (free):   http://host.docker.internal:11434/v1 (set any AI_MAP_API_KEY)
AI_MAP_BASE_URL=
AI_MAP_API_KEY=
AI_MAP_MODEL=

# ---- retention ----------------------------------------------------------------
# n8n execution history (hours; n8n default 336 = 14 days) — extended so the
# grafana trend charts have history.
EXECUTIONS_DATA_MAX_AGE=4380
PROMETHEUS_RETENTION=180d

# ---- form-trigger submit proxy ----------------------------------------------
# The dashboard's /form/ proxy lets the Actions tab fire n8n field-less form
# triggers same-origin (POST only). ON by default in Mode A (the Actions tab's
# whole point). OFF by default in Mode B: on a shared team box the single
# DASHBOARD_BASIC_AUTH password would otherwise let anyone who can load the
# dashboard fire triggers, bypassing n8n's own auth (the forward-auth overlay
# plus FORM_ALLOWED_GROUPS makes enabling it defensible). Set true/false to
# override the per-mode default.
ENABLE_FORM_PROXY=
# Upstream the proxy targets. Default http://n8n:5678 (the Mode A compose DNS
# name). In Mode B there is no `n8n` service — set this to the remote n8n URL if
# you deliberately enable the proxy there. Whitelisted to scheme://host[:port].
FORM_PROXY_UPSTREAM=http://n8n:5678
# Comma-separated OIDC group names allowed to fire forms. Enforced ONLY with the
# forward-auth overlay (below): nginx checks the verified $auth_groups from
# oauth2-proxy. With forward-auth ON and this LEFT EMPTY, form firing is DENIED
# for everyone (deny by default). With forward-auth OFF this has no enforcement
# point (no verified identity) and is ignored — the entrypoint logs a notice.
# Names are whitelisted to [A-Za-z0-9_-]; if your IdP emits group paths (e.g.
# Keycloak "/team-a"), configure it to emit slash-free names (or plain group
# names) so they match. Example: FORM_ALLOWED_GROUPS=platform,on-call
FORM_ALLOWED_GROUPS=

# ---- forward auth (optional overlay) ----------------------------------------
# Real identity via OIDC, instead of the single shared DASHBOARD_BASIC_AUTH
# password. Opt in by adding the overlay to either mode's up command:
#   docker compose -f docker-compose.yml          -f docker-compose.auth.yml up -d
#   docker compose -f docker-compose.readonly.yml -f docker-compose.auth.yml up -d
# The overlay runs an oauth2-proxy in front of the dashboard's nginx (via
# auth_request) and sets FORWARD_AUTH=true. When on, DASHBOARD_BASIC_AUTH is
# ignored (forward-auth wins — no double auth prompt). These vars are read ONLY
# by the overlay; they do nothing without it.
#
# All four below are REQUIRED when the overlay is used (compose fails fast if
# unset). Generic OIDC — works with Keycloak, Authentik, Google, GitLab, Okta:
#   OIDC issuer URL — the .well-known/openid-configuration base, e.g.
#     Keycloak:   https://idp.example.com/realms/<realm>
#     Authentik:  https://idp.example.com/application/o/<app-slug>/
#     Google:     https://accounts.google.com
#     GitLab:     https://gitlab.com
OAUTH2_PROXY_OIDC_ISSUER_URL=
# OAuth2 client id / secret from an app registration on that IdP. The redirect
# URI to register there is  http(s)://<dashboard host>/oauth2/callback.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# Cookie signing/encryption secret. Generate a fresh one:
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
#
# Optional (sensible defaults):
# Restrict which e-mail domains may sign in. '*' = any account the IdP returns;
# set your org's domain(s) (comma-separated) to lock it down.
OAUTH2_PROXY_EMAIL_DOMAINS=*
# Which OIDC claim carries group membership (surfaced as X-Auth-Request-Groups,
# matched by FORM_ALLOWED_GROUPS below). Default 'groups' matches
# Keycloak/Authentik/GitLab; some IdPs use a namespaced claim.
OAUTH2_PROXY_OIDC_GROUPS_CLAIM=groups
# Set true when the dashboard is served over HTTPS (recommended once exposed);
# leave false for a plain-HTTP localhost bind or the session cookie won't return.
OAUTH2_PROXY_COOKIE_SECURE=false
# Override only if your IdP pins an exact redirect URL that differs from the one
# oauth2-proxy derives from the forwarded Host (e.g. behind a TLS proxy):
#   OAUTH2_PROXY_REDIRECT_URL=https://po11y.example.com/oauth2/callback
OAUTH2_PROXY_REDIRECT_URL=
# NOTE: the "upstreams" env var is intentionally plural — oauth2-proxy
# pluralises multi-value args. The overlay hard-codes OAUTH2_PROXY_UPSTREAMS=
# static://202 (auth-endpoint-only; no backend is ever proxied), so you do not
# set it here.

# =============================================================================
# Mode B — read-only collector stack (docker-compose.readonly.yml)
# =============================================================================
# Point po11y at an EXISTING n8n without running n8n/postgres/bootstrap here.
# Bring up with:  docker compose -f docker-compose.readonly.yml up -d
# Reuses from above: BIND_ADDR, DASHBOARD_PORT, DASHBOARD_BASIC_AUTH,
# GRAFANA_ADMIN_PASSWORD, PROMETHEUS_RETENTION, DASHBOARD_GRAFANA_EMBED,
# AI_MAP_* (optional map prose).
#
# Base URL of the remote n8n (required).
N8N_API_URL=
# A public-API key on that n8n (required). Used GET-only by the collector. On
# n8n Community Edition keys cannot be scoped, so keep this key to a trusted
# operator — the collector's GET-only discipline is the access control.
N8N_API_KEY=
# Seconds between polls (default 600).
POLL_INTERVAL=600
# Where feeds are written (default /po11y-status). Set /po11y-status/<scope>
# to run a second, scoped collector against the same shared volume.
STATUS_DIR=
# host:port of the remote n8n's /metrics for prometheus to scrape (required for
# the Grafana tab). The remote n8n must run with N8N_METRICS=true; absent
# metrics just leave the Grafana tab empty.
N8N_METRICS_TARGET=
