        "jsCode": "// Demo workflow: accepts a POSTed order and hands it to a sub-workflow.\n// Zero credentials and no outbound calls. It exists so a fresh install has a\n// webhook trigger and a real sub-workflow edge on the architecture map.\n// POST anything to /webhook/po11y-intake to produce an execution.\nreturn items.map((item) => {\n  const body = (item.json && item.json.body) || item.json || {};\n  return {\n    json: {\n      order_id: body.order_id || `demo-${Math.floor(Math.random() * 100000)}`,\n      email: body.email || 'someone@example.com',\n      amount: Number(body.amount || 0),\n    },\n  };\n});"
