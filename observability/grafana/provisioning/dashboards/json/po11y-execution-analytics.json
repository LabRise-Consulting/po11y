            "type": "prometheus",
            "uid": "n8n-prometheus"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "topk(10, po11y_workflow_errors_total > 0)",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "{{workflow_name}}",
          "refId": "A"
        }
      ],
      "title": "Workflows with most failures",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "n8n-prometheus"
      },
      "description": "Share of each workflow's finished executions that failed. Reads differently from the raw count beside it: a workflow with two failures out of three runs is in more trouble than one with ten out of ten thousand.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "mappings": [],
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "id": 22,
      "options": {
        "displayMode": "gradient",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "pluginVersion": "11.3.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "n8n-prometheus"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "topk(10, 100 * po11y_workflow_errors_total / po11y_workflow_executions_total > 0)",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "{{workflow_name}}",
          "refId": "A"
        }
      ],
      "title": "Failure rate by workflow",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "n8n-prometheus"
      },
      "description": "How long ago each workflow last produced a successful execution. A workflow that has never succeeded within po11y's retention window is absent rather than shown as 1970.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "workflow_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in n8n",
                    "url": "http://${n8n_host}:5678/workflow/${__value.text}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Since last success"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 86400
                    },
                    {
                      "color": "red",
                      "value": 604800
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 9
      },
      "id": 21,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Since last success"
          }
        ]
      },
      "pluginVersion": "11.3.1",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "n8n-prometheus"
          },
          "editorMode": "code",
          "exemplar": false,
          "expr": "time() - po11y_workflow_last_success_timestamp_seconds",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "Time since last success",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "workflow_name": "Workflow"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "n8n-prometheus"
      },
      "description": "Age of the oldest in-flight execution per workflow. A line that climbs and never returns to zero is the shape of a stuck run.",
